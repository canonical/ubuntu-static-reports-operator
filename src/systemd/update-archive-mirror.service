[Unit]
Description=Ubuntu Static Reports - archive mirror sync
OnSuccess=update-germinate.service update-nbs.service

[Service]
Type=notify
# The script signals READY after acquiring the lock, so the unit shows
# "running" instead of "activating" during long rsync runs.

User=ubuntu
KeyringMode=private
NoNewPrivileges=true
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes

EnvironmentFile=-/etc/staticreports/archive-mirror.env
ExecStart=/usr/bin/update-archive-mirror
