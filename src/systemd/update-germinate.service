[Unit]
Description=Ubuntu Static Reports - Germinate archive snapshot
OnSuccess=update-mismatches.service seeded-in-ubuntu-indexer.service

[Service]
Type=oneshot
# Can be quite CPU hungry. OK when idle but reduce stress to other load
Nice=15
CPUWeight=50

User=ubuntu
KeyringMode=private
NoNewPrivileges=true
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes

EnvironmentFile=-/etc/staticreports/archive-mirror.env
ExecStart=/usr/bin/update-germinate
