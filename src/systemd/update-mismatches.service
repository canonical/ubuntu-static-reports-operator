[Unit]
Description=Ubuntu Static Reports - Archive Mismatches reports

[Service]
Type=oneshot
TimeoutStartSec=2h
EnvironmentFile=-/etc/staticreports/mismatches.env

User=ubuntu
KeyringMode=private
NoNewPrivileges=true
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes

WorkingDirectory=/usr/local/src/ubuntu-archive-tools
ExecStart=update-mismatches
