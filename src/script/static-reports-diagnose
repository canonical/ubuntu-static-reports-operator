#!/usr/bin/env python3
"""Report local Ubuntu Static Reports health without changing system state."""

import argparse
import json
import sys
from pathlib import Path

try:
    import staticreports_health as health
except ModuleNotFoundError:  # Allow direct execution from the source tree.
    sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
    import staticreports_health as health

DOCUMENTATION = (
    "https://github.com/canonical/ubuntu-static-reports-operator/blob/main/docs/operations.md"
)


def parse_args(argv=None) -> argparse.Namespace:
    """Parse command-line options without collecting any system state."""
    parser = argparse.ArgumentParser(
        prog="static-reports-diagnose",
        description=(
            "Check every static report and local nginx, or one selected report. "
            "This command is read-only: it never starts, stops, or restarts a service."
        ),
        epilog=(
            "Exit codes: 0=OK, 1=warning/waiting, 2=critical, 3=unknown/collection error.\n"
            f"Documentation and health meanings: {DOCUMENTATION}"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--service",
        choices=health.SERVICE_NAMES,
        help="Check only this report (default: check all reports and local nginx).",
    )
    parser.add_argument(
        "--format",
        choices=("text", "json"),
        default="text",
        help="Output human-readable text or versioned JSON (default: text).",
    )
    return parser.parse_args(argv)


def format_text(document: dict) -> str:
    """Render a concise human view of the shared health document."""
    lines = [f"Overall: {document['status'].upper()} - {document['summary']}"]
    if serving := document.get("serving"):
        lines.append(f"Local nginx: {serving['status'].upper()} - {serving['reason']}")
    for report in document["reports"]:
        lines.append(
            f"{report['service']}: {report['status'].upper()} "
            f"({report['outcome']}) - {report['reason']}"
        )
        if last_success := report.get("last_success_at"):
            lines.append(f"  Last successful check: {last_success}")
        if publication := report.get("last_publication_at"):
            lines.append(f"  Last publication: {publication}")
        if "lineage_current" in report:
            lines.append(f"  Lineage current: {str(report['lineage_current']).lower()}")
    return "\n".join(lines)


def main(argv=None, collector=None) -> int:
    """Run diagnostics and return the documented process exit code."""
    args = parse_args(argv)
    try:
        document = (collector or health.HealthCollector()).collect(args.service)
    except (health.HealthCollectionError, OSError) as error:
        document = {
            "schema_version": health.SCHEMA_VERSION,
            "generated_at": health.iso_time(),
            "status": "unknown",
            "summary": f"Could not collect health evidence: {error}",
            "reports": [],
            "serving": None,
        }
    if args.format == "json":
        print(json.dumps(document, indent=2, sort_keys=True))
    else:
        print(format_text(document))
    return health.exit_code(document)


if __name__ == "__main__":
    sys.exit(main())
