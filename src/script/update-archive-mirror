#!/usr/bin/env python3
"""Keep an incremental archive-indices mirror and publish atomic snapshots.

Rsyncs the archive indices into a persistent work directory, then—when
something changed—freezes a hardlink copy as a new snapshot and atomically
repoints <out>/current at it.  Downstream consumers (NBS, germinate) read
from <out>/current/ubuntu/.

A new snapshot is only published when the archive Release identities changed
and all merged Packages/Sources files match the primary Release metadata.
Regressing or inconsistent candidates leave the previous snapshot untouched.
Most timer ticks exit cheaply after the rsync.  update-germinate is triggered
on success via systemd OnSuccess=.

Options can be overridden on the command line or via environment variables
(the systemd unit sources /etc/staticreports/archive-mirror.env).
"""

import argparse
import fcntl
import hashlib
import logging
import os
import shlex
import shutil
import socket
import subprocess
import sys
import time
from dataclasses import dataclass
from datetime import datetime, timezone
from email.utils import parsedate_to_datetime
from pathlib import Path

import lp_series

logger = logging.getLogger("update-archive-mirror")

HOME = Path(os.environ.get("HOME", "/home/ubuntu"))


def _sd_notify(message: str) -> None:
    """Send one sd_notify(3) message; a no-op when not run from systemd."""
    socket_name = os.environ.get("NOTIFY_SOCKET")
    if not socket_name:
        return
    if socket_name.startswith("@"):
        socket_name = "\0" + socket_name[1:]
    elif not socket_name.startswith("/"):
        socket_name = "/run/" + socket_name
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as notifier:
        notifier.connect(socket_name)
        notifier.send(message.encode())


def parse_args(argv=None) -> argparse.Namespace:
    """Parse command-line options."""
    parser = argparse.ArgumentParser(
        description="Publish an atomic archive-indices snapshot."
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="Rebuild and publish even if no archive inputs changed.",
    )
    parser.add_argument(
        "--out",
        type=Path,
        default=Path(os.environ.get("MIRROR_DIR", "/srv/staticreports")) / "archive",
        help="Directory to publish archive snapshots into (holds the 'current' symlink).",
    )
    parser.add_argument(
        "--archive-rsync-source",
        default=os.environ.get("RSYNC_ARCHIVE_SOURCE", "rsync://rsync.archive.ubuntu.com/ubuntu/dists/"),
        help="rsync source for the archive indices (the dists tree).",
    )
    parser.add_argument(
        "--ports-rsync-source",
        default=os.environ.get(
            "RSYNC_PORTS_SOURCE", "rsync://rsync.ports.ubuntu.com/ubuntu-ports/dists/"
        ),
        help="rsync source for the ports archive indices (merged into the same dists tree).",
    )
    parser.add_argument(
        "--retention",
        type=int,
        default=int(os.environ.get("RETENTION", "3")),
        help="Number of snapshots to keep (older ones are pruned).",
    )
    return parser.parse_args(argv)


def _run(cmd: list, **kwargs) -> subprocess.CompletedProcess:
    """Run a command, raising CalledProcessError on failure."""
    logger.info("Running: %s", shlex.join(str(part) for part in cmd))
    return subprocess.run(cmd, check=True, **kwargs)


@dataclass(frozen=True)
class ReleaseInfo:
    """Publisher metadata needed to validate and identify one suite."""

    date: datetime
    digest: str
    algorithm: str
    checksums: dict[str, tuple[int, str]]


def _release_date(raw_date: str | None, release: Path) -> datetime:
    if raw_date is None:
        raise ValueError(f"No Date field in {release}")
    try:
        date = parsedate_to_datetime(raw_date)
    except (TypeError, ValueError) as error:
        raise ValueError(f"Invalid Date field in {release}: {raw_date!r}") from error
    if date is None or date.tzinfo is None:
        raise ValueError(f"Invalid Date field in {release}: {raw_date!r}")
    return date.astimezone(timezone.utc)


def _read_release(release: Path) -> ReleaseInfo:
    """Parse a Release's date, identity and strongest available checksums."""
    content = release.read_bytes()
    sections: dict[str, dict[str, tuple[int, str]]] = {"SHA512": {}, "SHA256": {}}
    section = None
    raw_date = None
    for line in content.decode("utf-8").splitlines():
        if line.startswith("Date:"):
            raw_date = line.split(":", 1)[1].strip()
        if not line[:1].isspace():
            section = line[:-1] if line[:-1] in sections and line.endswith(":") else None
            continue
        if section is None:
            continue
        try:
            digest, size, filename = line.split()
            sections[section][filename] = (int(size), digest)
        except ValueError as error:
            raise ValueError(f"Invalid {section} entry in {release}: {line!r}") from error
    date = _release_date(raw_date, release)
    for field, algorithm in (("SHA512", "sha512"), ("SHA256", "sha256")):
        if sections[field]:
            return ReleaseInfo(
                date=date,
                digest=hashlib.sha256(content).hexdigest(),
                algorithm=algorithm,
                checksums=sections[field],
            )
    raise ValueError(f"No SHA512 or SHA256 entries in {release}")


def _read_releases(mirror: Path) -> dict[str, ReleaseInfo]:
    """Read top-level suite Releases from one archive work tree."""
    return {
        release.parent.name: _read_release(release)
        for release in sorted((mirror / "dists").glob("*/Release"))
    }


def _expected_indices(
    releases: dict[str, ReleaseInfo], require_complete: bool
) -> set[tuple[str, str]]:
    """Return the suite/index pairs required in a complete merged snapshot."""
    if not require_complete:
        return set()
    return {
        (suite, filename)
        for suite, info in releases.items()
        for filename in info.checksums
        if filename.rsplit("/", 1)[-1].startswith(("Packages", "Sources"))
    }


def _hash_file(path: Path, algorithm: str) -> str:
    digest = hashlib.new(algorithm)
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _validate_indices(snapshot_ubuntu: Path, require_complete: bool = True) -> int:
    """Validate all merged Packages/Sources files against the primary Releases."""
    dists = snapshot_ubuntu / "dists"
    releases = {
        release.parent.name: _read_release(release) for release in dists.glob("*/Release")
    }
    if not releases:
        raise ValueError(f"No Release files found below {dists}")
    patterns = (
        "*/*/binary-*/Packages*",
        "*/*/debian-installer/binary-*/Packages*",
        "*/*/source/Sources*",
    )
    indices = {path for pattern in patterns for path in dists.glob(pattern) if path.is_file()}
    if not indices:
        raise ValueError(f"No Packages/Sources index files found below {dists}")

    expected = _expected_indices(releases, require_complete)

    index_data = []
    actual = set()
    for index in sorted(indices):
        relative = index.relative_to(dists)
        suite = relative.parts[0]
        if suite not in releases:
            raise ValueError(f"No primary Release for merged index {index}")
        filename = relative.relative_to(suite).as_posix()
        index_data.append((index, suite, filename))
        actual.add((suite, filename))
    missing = sorted(expected - actual)
    if missing:
        suite, filename = missing[0]
        raise ValueError(f"Missing index {dists / suite / filename} listed in primary Release")

    for index, suite, filename in index_data:
        release = dists / suite / "Release"
        info = releases[suite]
        if filename not in info.checksums:
            raise ValueError(f"No {info.algorithm.upper()} entry for {index} in {release}")
        expected_size, expected_digest = info.checksums[filename]
        if index.stat().st_size != expected_size:
            raise ValueError(f"Size mismatch for {index} against {release}")
        if _hash_file(index, info.algorithm) != expected_digest:
            raise ValueError(f"Checksum mismatch for {index} against {release}")
    logger.info(
        "Validated %d archive index files against their Release metadata.", len(index_data)
    )
    return len(index_data)


def _series_filters() -> list:
    """Build the series whitelist for the rsync filter list.

    Only active series (maintained under standard support, ESM, or Legacy,
    plus the series in development) and the persistent devel alias suites
    are mirrored. Every other top-level suite dir is excluded, so the
    file-level includes below cannot pull indices out of EOL series, and
    --delete-excluded prunes the mirror down to exactly this whitelist.
    """
    filters = []
    for series in lp_series.active_series():
        filters += ["--include", f"/{series}/", "--include", f"/{series}-*/"]
    filters += ["--include", "/devel/", "--include", "/devel-*/"]
    filters += ["--exclude", "/*/"]
    return filters


def _merge_ports_into_snapshot(snapshot_ubuntu: Path, ports_mirror: Path) -> None:
    """Hardlink the ports mirror's Packages indices into the snapshot's dists tree.

    The snapshot already contains the primary archive's tree (a hardlink
    copy made by cp -al); existing destinations are skipped, so ports
    only fills paths the primary does not publish. Ports' Release and
    Sources files are not taken; they describe a different archive.
    """
    dists = ports_mirror / "dists"
    if not dists.is_dir():
        return
    for packages in [
        *dists.glob("*/*/binary-*/Packages*"),
        *dists.glob("*/*/debian-installer/binary-*/Packages*"),
    ]:
        rel = packages.relative_to(dists)
        dest = snapshot_ubuntu / "dists" / rel
        if dest.exists():
            continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        os.link(packages, dest)


def _rsync_archive(mirror: Path, source: str) -> None:
    """Mirror one archive's indices (never the pool) into its own work tree.

    The tree is a full self-contained mirror, so --delete and
    --delete-excluded correctly prune anything the source no longer
    publishes or that falls out of the active-series whitelist (EOL
    series, dropped architectures).
    """
    file_filters = []
    for pattern in ("Packages*", "Sources*", "Release*", "udeb.list", "**/installer-*/current"):
        file_filters += ["--include", pattern]

    _run(
        [
            "rsync",
            "-aq",
            "--timeout=1200",
            *_series_filters(),
            *file_filters,
            "--include",
            "*/",
            "--exclude",
            "*",
            "--delete",
            "--delete-excluded",
            "--prune-empty-dirs",
            source,
            f"{mirror}/dists/",
        ]
    )


def sync_archive(mirror: Path, archive_source: str, ports_source: str) -> None:
    """Sync the primary archive and ports indices into separate work trees."""
    _rsync_archive(mirror, archive_source)
    if ports_source:
        ports_mirror = mirror.parent / "ubuntu-ports"
        ports_mirror.mkdir(parents=True, exist_ok=True)
        _rsync_archive(ports_mirror, ports_source)


def _read_stamp(snapshot: Path) -> dict[str, str]:
    try:
        lines = (snapshot / "STAMP").read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return {}
    fields = (line.split(":", 1) for line in lines if ":" in line)
    return {key: value.strip() for key, value in fields}


def _release_digests_from_stamp(stamp: dict[str, str], origin: str) -> dict[str, str]:
    prefix = f"{origin}-Release-SHA256-"
    return {key[len(prefix) :]: value for key, value in stamp.items() if key.startswith(prefix)}


def _same_release_inputs(
    primary: dict[str, ReleaseInfo], ports: dict[str, ReleaseInfo], stamp: dict[str, str]
) -> bool:
    """Check whether the candidate Releases match the last accepted snapshot."""
    if not primary:
        return False
    return all(
        {suite: info.digest for suite, info in releases.items()}
        == _release_digests_from_stamp(stamp, origin)
        for origin, releases in (("Primary", primary), ("Ports", ports))
    )


def _validate_suite_coverage(
    primary: dict[str, ReleaseInfo], ports: dict[str, ReleaseInfo], ports_enabled: bool
) -> None:
    """Require both configured archives to provide metadata for the same suites."""
    if not ports_enabled or primary.keys() == ports.keys():
        return
    primary_only = sorted(primary.keys() - ports.keys())
    ports_only = sorted(ports.keys() - primary.keys())
    raise ValueError(f"Primary-only suites: {primary_only}; ports-only suites: {ports_only}")


def _validate_release_progress(
    primary: dict[str, ReleaseInfo], ports: dict[str, ReleaseInfo], stamp: dict[str, str]
) -> None:
    """Reject candidates older than the accepted generation of either origin."""
    for origin, releases in (("Primary", primary), ("Ports", ports)):
        for suite, info in releases.items():
            key = f"{origin}-Release-Date-{suite}"
            if key not in stamp:
                # Old STAMPs have no baseline. The first hash-coherent candidate
                # establishes one; missing provenance must not block upgrades forever.
                continue
            previous = datetime.fromisoformat(stamp[key])
            if previous.tzinfo is None:
                raise ValueError(f"Invalid previous timestamp in STAMP: {key}: {stamp[key]}")
            if info.date < previous:
                raise ValueError(
                    f"{origin} Release for {suite} regressed from "
                    f"{previous.isoformat()} to {info.date.isoformat()}"
                )


def _write_stamp(
    snapshot: Path, primary: dict[str, ReleaseInfo], ports: dict[str, ReleaseInfo]
) -> None:
    lines = [
        f"Generated: {time.strftime('%a %b %e %H:%M:%S %Z %Y', time.gmtime())}",
        f"Release-files: {len(primary)}",
    ]
    for origin, releases in (("Primary", primary), ("Ports", ports)):
        for suite, info in sorted(releases.items()):
            lines += [
                f"{origin}-Release-Date-{suite}: {info.date.isoformat()}",
                f"{origin}-Release-SHA256-{suite}: {info.digest}",
            ]
    lines.append("")
    (snapshot / "STAMP").write_text("\n".join(lines))


def swap_current(publish_root: Path, snapshot: Path) -> None:
    """Atomically repoint `current` at the new snapshot via a rename."""
    tmp = publish_root / f".current.{os.getpid()}"
    if tmp.is_symlink() or tmp.exists():
        tmp.unlink()
    tmp.symlink_to(snapshot.name)
    os.replace(tmp, publish_root / "current")


def gc_snapshots(publish_root: Path, retention: int) -> None:
    """Keep the newest `retention` snapshots plus whatever `current` points at."""
    current = publish_root / "current"
    snapshots = sorted(publish_root.glob("snapshot.*"), key=lambda p: p.name)
    keep = {s.name for s in snapshots[-retention:]}
    if current.is_symlink():
        keep.add(os.path.basename(os.readlink(current)))
    for snapshot in snapshots:
        if snapshot.name not in keep:
            logger.info("Pruning old snapshot %s.", snapshot.name)
            shutil.rmtree(snapshot, ignore_errors=True)


def sync_and_publish(
    out: Path,
    archive_rsync_source: str,
    ports_rsync_source: str,
    retention: int = 3,
    force: bool = False,
) -> int:
    """Run one sync-and-publish cycle under the mirror lock."""
    mirror = out / "work" / "ubuntu"
    mirror.mkdir(parents=True, exist_ok=True)
    out.mkdir(parents=True, exist_ok=True)

    with open(HOME / ".update-archive-mirror.lock", "w") as lock_handle:
        try:
            fcntl.flock(lock_handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            logger.info("Another update-archive-mirror run is in progress; exiting.")
            return 0

        # Announce readiness now that this instance is the active worker.
        _sd_notify("READY=1")
        return _sync_and_publish_locked(
            out, archive_rsync_source, ports_rsync_source, retention, force
        )


def _sync_and_publish_locked(
    out: Path,
    archive_rsync_source: str,
    ports_rsync_source: str,
    retention: int,
    force: bool,
) -> int:
    """Run one cycle; the caller holds the mirror lock."""
    mirror = out / "work" / "ubuntu"
    ports_mirror = out / "work" / "ubuntu-ports"
    current = out / "current"

    sync_archive(mirror, archive_rsync_source, ports_rsync_source)
    try:
        primary = _read_releases(mirror)
        ports = _read_releases(ports_mirror)
        stamp = _read_stamp(current)
    except (OSError, UnicodeError, ValueError) as error:
        logger.error(
            "Could not read archive Release metadata: %s; keeping previous snapshot.", error
        )
        return 1

    have_current = current.is_symlink() and current.exists()
    rebuild = force or not have_current or not _same_release_inputs(primary, ports, stamp)
    if not rebuild:
        logger.info("No archive changes since last snapshot; nothing to do.")
        return 0
    try:
        _validate_suite_coverage(primary, ports, bool(ports_rsync_source))
        _validate_release_progress(primary, ports, stamp)
    except ValueError as error:
        logger.error("Archive Release validation failed: %s; keeping previous snapshot.", error)
        return 1

    snapshot_name = "snapshot." + time.strftime("%Y%m%dT%H%M%S", time.gmtime())
    staging = out / f".staging.{snapshot_name}"
    if staging.exists():
        shutil.rmtree(staging)
    staging.mkdir(parents=True)

    # Build the archive snapshot inside a hidden staging directory so the
    # final snapshot.<timestamp> entry only appears once fully written.
    # Freeze the just-synced indices with hardlinks so a later rsync into
    # the work mirror cannot mutate the staged snapshot.
    _run(["cp", "-al", str(mirror), str(staging / "ubuntu")])
    _merge_ports_into_snapshot(staging / "ubuntu", ports_mirror)
    try:
        _validate_indices(staging / "ubuntu", require_complete=bool(ports_rsync_source))
    except (OSError, ValueError) as error:
        logger.error("Archive snapshot validation failed: %s; keeping previous snapshot.", error)
        shutil.rmtree(staging, ignore_errors=True)
        return 1
    _write_stamp(staging, primary, ports)
    snapshot = out / snapshot_name
    os.rename(staging, snapshot)
    swap_current(out, snapshot)
    gc_snapshots(out, max(1, retention))
    logger.info("Published archive snapshot %s in %s.", snapshot.name, out)
    return 0


def main(argv=None) -> int:
    """Entry point."""
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    args = parse_args(argv)
    return sync_and_publish(
        out=args.out,
        archive_rsync_source=args.archive_rsync_source,
        ports_rsync_source=args.ports_rsync_source,
        retention=args.retention,
        force=args.force,
    )


if __name__ == "__main__":
    sys.exit(main())
