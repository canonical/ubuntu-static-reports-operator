#!/usr/bin/python3
"""Germinate Ubuntu seeds against a local archive snapshot.

By default, germinates every series present in the local archive against the
release pocket.  With --pocket proposed, germinates only the development
series against the full proposed-pocket ogre stack (update-germinate invokes
this script twice, once per pocket, into the same output root).

Output is laid out per flavour/series/pocket as
``<flavour>/<series>/<pocket>/<seed>_<flavour>_<series>_<arch>``; the
``<seed>_<flavour>_<series>_<arch>`` file naming that component-mismatches
and other archive-admin tools expect is preserved.  Hardlink views for the
legacy consumers (a flat per-pocket view, and a ``germinate-output/`` view
replicating the old archive-team site) are built by update-germinate, which
invokes this script for both pockets into one output root and owns the
published layout.

Based on lib/lp/archivepublisher/scripts/generate_extra_overrides.py from
Launchpad, which is:

Copyright 2011-2012 Canonical Ltd.  This software is licensed under the
GNU Affero General Public License version 3 (see the file LICENSE).
"""

import argparse
import copy
import logging
import os
import pickle
import subprocess
import sys
import traceback
from collections.abc import Callable
from pathlib import Path

from germinate.archive import TagFile
from germinate.germinator import Germinator
from germinate.log import GerminateFormatter
from germinate.seeds import Seed, SeedError, SeedStructure

COMPONENTS = ["main", "restricted", "universe", "multiverse"]


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    """CLI interface."""
    parser = argparse.ArgumentParser(
        description="Germinate Ubuntu seeds against a local archive snapshot."
    )
    parser.add_argument(
        "--pocket",
        choices=["release", "proposed"],
        default="release",
        help=(
            "Pocket to germinate; 'proposed' uses the full ogre stack and "
            "only the development series."
        ),
    )
    parser.add_argument(
        "-s",
        "--series",
        metavar="SERIES",
        help=(
            "Only germinate this series (default: all series in the archive, "
            "or the development series for --pocket proposed)."
        ),
    )
    parser.add_argument(
        "-o",
        "--output",
        default="germinate",
        help="Output root for the <flavour>/<series>/<pocket>/ tree.",
    )
    parser.add_argument(
        "--archiveroot",
        default=f"file://{Path.home() / 'mirror' / 'ubuntu'}",
        help="Distribution archive root URL.",
    )
    parser.add_argument(
        "-S",
        "--seed-source",
        metavar="URL",
        help="Seed base URL.",
    )
    parser.add_argument(
        "--flavours",
        help="Comma-separated flavours to germinate (default: all found in the seed source).",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    """Entry point."""
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    args = parse_args(argv)
    seed_bases = [args.seed_source] if args.seed_source else None
    flavours = None
    if args.flavours:
        flavours = [f.strip() for f in args.flavours.split(",") if f.strip()]

    germinate_logger = logging.getLogger("germinate")
    germinate_logger.setLevel(logging.INFO)
    germinate_logger.propagate = False

    pocket = args.pocket
    if args.series:
        series_list = [args.series]
    elif pocket == "proposed":
        series_list = [_devel_series()]
    else:
        series_list = _series_from_archive(args.archiveroot)

    # Ordered pockets forming a Launchpad "ogre" stack: later suites
    # override earlier ones (release < security < updates < proposed).
    ogre_suites: Callable[[str], list[str]]
    if pocket == "proposed":
        ogre_suites = _ogre_suites
    else:
        ogre_suites = lambda series: [series, f"{series}-updates"]  # noqa: E731

    outdir = args.output
    os.makedirs(outdir, exist_ok=True)
    handler = logging.FileHandler(os.path.join(outdir, "germinate.output"), mode="w")
    handler.setFormatter(GerminateFormatter())
    germinate_logger.addHandler(handler)
    try:
        for series in series_list:
            suite = series if pocket == "release" else f"{series}-{pocket}"
            try:
                germinate_suite(
                    suite,
                    flavours,
                    args.archiveroot,
                    outdir,
                    seed_bases,
                    germinate_logger,
                    ogre_suites=ogre_suites(series),
                    pocket=pocket,
                )
            except Exception as e:
                logging.warning("Failed to germinate %s: %s", suite, e)
    finally:
        germinate_logger.removeHandler(handler)
        handler.close()

    return 0


class _BufferHandler(logging.Handler):
    """Accumulate serialised log records for sequential replay in the parent."""

    def __init__(self):
        super().__init__()
        self.records: list[bytes] = []

    def emit(self, record: logging.LogRecord) -> None:
        record = copy.copy(record)
        record.msg = record.getMessage()
        record.args = None
        self.records.append(pickle.dumps(record, -1))


def _archs_from_release(archiveroot: str, series: str) -> list[str]:
    """Parse the Architectures field from the series Release file."""
    if not archiveroot.startswith("file://"):
        raise RuntimeError("Architecture discovery requires a file:// archiveroot")
    release = Path(archiveroot[len("file://") :]) / "dists" / series / "Release"
    for line in release.read_text().splitlines():
        if line.startswith("Architectures:"):
            return line.split(":", 1)[1].split()
    raise RuntimeError(f"No Architectures field in {release}")


def _series_from_archive(archiveroot: str) -> list[str]:
    """Return the top-level series present in the local archive mirror."""
    if not archiveroot.startswith("file://"):
        raise RuntimeError("Series discovery requires a file:// archiveroot")
    dists = Path(archiveroot[len("file://") :]) / "dists"
    return sorted(
        p.name for p in dists.iterdir() if "-" not in p.name and (p / "Release").exists()
    )


def _devel_series() -> str:
    return subprocess.run(
        ["distro-info", "--devel"], capture_output=True, text=True, check=True
    ).stdout.strip()


def _ogre_suites(suite: str) -> list[str]:
    """Expand a suite to the ordered set of pockets for the ogre model."""
    if "-" not in suite:
        return [suite]
    series, pocket = suite.split("-", 1)
    suites = [series]
    if pocket in ("updates", "security", "proposed"):
        suites.append(f"{series}-security")
    if pocket in ("updates", "proposed"):
        suites.append(f"{series}-updates")
    if pocket == "proposed":
        suites.append(f"{series}-proposed")
    return suites


def _flavours_from_seeds(seed_bases: list[str] | None, series: str) -> list[str]:
    """Flavours with a <flavour>.<series> branch in a local update-seeds workdir."""
    if not seed_bases:
        return []
    flavours = set()
    for seed_base in seed_bases:
        if not seed_base.startswith("file://"):
            continue
        root = Path(seed_base[len("file://") :])
        if not root.is_dir():
            continue
        for entry in root.iterdir():
            if entry.name.endswith(f".{series}") and entry.is_dir():
                flavours.add(entry.name[: -len(f".{series}")])
    return sorted(flavours)


def _make_seed_structures(
    suite: str, flavours: list[str], seed_bases: list[str] | None
) -> dict[str, SeedStructure]:
    series = suite.split("-")[0]
    structures = {}
    for flavour in flavours:
        try:
            structure = SeedStructure(f"{flavour}.{series}", seed_bases=seed_bases)
            if len(structure):
                structures[flavour] = structure
            else:
                logging.warning("Skipping empty seed structure for %s.%s", flavour, series)
        except SeedError as e:
            logging.warning("Failed to fetch seeds for %s.%s: %s", flavour, series, e)
    return structures


def _write_germinate_output(
    germinator: Germinator,
    structure: SeedStructure,
    outdir: str,
    flavour: str,
    suite: str,
    arch: str,
    seed_outputs: set[str],
    pocket: str,
) -> None:
    series = suite.split("-")[0]
    tree_dir = Path(outdir) / flavour / series / pocket
    tree_dir.mkdir(parents=True, exist_ok=True)

    def path(base: str) -> str:
        p = tree_dir / f"{base}_{flavour}_{series}_{arch}"
        seed_outputs.add(p.name)
        return str(p)

    germinator.write_all_list(structure, path("all"))
    germinator.write_all_source_list(structure, path("all.sources"))
    germinator.write_all_snap_list(structure, path("all.snaps"))
    germinator.write_all_extra_list(structure, path("all+extra"))
    germinator.write_all_extra_source_list(structure, path("all+extra.sources"))
    germinator.write_supported_list(structure, path(f"{structure.supported}+build-depends"))
    germinator.write_supported_source_list(
        structure, path(f"{structure.supported}+build-depends.sources")
    )
    germinator.write_provides_list(structure, path("provides"))
    structure.write(path("structure"))
    structure.write_dot(path("structure.dot"))
    # renamed to write_blocklisted in newer germinate
    if hasattr(germinator, "write_blocklisted"):
        germinator.write_blocklisted(structure, path("blocklisted"))
    else:
        germinator.write_blacklisted(structure, path("blacklisted"))
    # The old CLI writes an "extra" pseudo-seed alongside the real seeds; it
    # has no seed text or source list of its own.
    for seedname in [*structure.names, "extra"]:
        germinator.write_full_list(structure, path(seedname), seedname)
        germinator.write_seed_list(structure, path(f"{seedname}.seed"), seedname)
        germinator.write_seed_recommends_list(
            structure, path(f"{seedname}.seed-recommends"), seedname
        )
        germinator.write_depends_list(structure, path(f"{seedname}.depends"), seedname)
        germinator.write_build_depends_list(structure, path(f"{seedname}.build-depends"), seedname)
        germinator.write_build_sources_list(structure, path(f"{seedname}.build-sources"), seedname)
        germinator.write_snap_list(structure, path(f"{seedname}.snaps"), seedname)
        if seedname != "extra" and seedname in structure:
            structure.write_seed_text(path(f"{seedname}.seedtext"), seedname)
            germinator.write_sources_list(structure, path(f"{seedname}.sources"), seedname)


def _germinate_arch(
    suite: str,
    components: list[str],
    arch: str,
    structures: dict[str, SeedStructure],
    archiveroot: str,
    outdir: str,
    suites: list[str],
    pocket: str,
    seed_bases: list[str] | None,
) -> set[str]:
    """Germinate all flavours for one architecture. Runs in a forked child."""
    glog = logging.getLogger("germinate")
    germinator = Germinator(arch)
    archive = TagFile(suites, components, arch, archiveroot, cleanup=True)
    germinator.parse_archive(archive)

    seed_outputs: set[str] = set()
    for flavour, structure in structures.items():
        if flavour == "i386" and arch != "i386":
            continue
        logging.info("Germinating for %s/%s/%s", flavour, suite, arch)
        glog.info("", extra={"progress": True})
        glog.info("Germinating for %s/%s/%s", flavour, suite, arch, extra={"progress": True})

        germinator.plant_seeds(structure)
        if seed_bases:
            series = suite.split("-")[0]
            try:
                with Seed(seed_bases, f"{flavour}.{series}", "blacklist") as blacklist:
                    # renamed to parse_blocklist in newer germinate
                    if hasattr(germinator, "parse_blocklist"):
                        germinator.parse_blocklist(structure, blacklist)
                    else:
                        germinator.parse_blacklist(structure, blacklist)
            except SeedError:
                pass
        germinator.grow(structure)
        germinator.add_extras(structure)
        _write_germinate_output(
            germinator, structure, outdir, flavour, suite, arch, seed_outputs, pocket
        )

    return seed_outputs


def _germinate_arch_child(close_fds: list[int], wfd: int, *args) -> int:
    try:
        for fd in close_fds:
            os.close(fd)

        # Replace the parent's file handler with an in-memory buffer so the
        # child's log output is replayed sequentially in the parent.
        glog = logging.getLogger("germinate")
        glog.handlers.clear()
        buf = _BufferHandler()
        glog.addHandler(buf)

        seed_outputs = _germinate_arch(*args)

        with os.fdopen(wfd, "wb") as w:
            pickle.dump((buf.records, seed_outputs), w, -1)
        return 0
    except Exception:
        traceback.print_exc()
        with os.fdopen(wfd, "wb") as w:
            pickle.dump(([], set()), w, -1)
        return 1


def germinate_suite(
    suite: str,
    flavours: list[str] | None,
    archiveroot: str,
    outdir: str,
    seed_bases: list[str] | None,
    germinate_logger: logging.Logger,
    ogre_suites: list[str] | None = None,
    pocket: str = "release",
) -> None:
    """Germinate one suite, forking a child per architecture."""
    series = suite.split("-")[0]
    if not flavours:
        flavours = _flavours_from_seeds(seed_bases, series)
    structures = _make_seed_structures(suite, flavours, seed_bases)
    if not structures:
        return

    archs = _archs_from_release(archiveroot, series)
    suites = ogre_suites if ogre_suites is not None else _ogre_suites(suite)

    procs = []
    close_fds: list[int] = []
    for arch in archs:
        rfd, wfd = os.pipe()
        close_fds.append(rfd)
        pid = os.fork()
        if pid == 0:
            os._exit(
                _germinate_arch_child(
                    close_fds,
                    wfd,
                    suite,
                    COMPONENTS,
                    arch,
                    structures,
                    archiveroot,
                    outdir,
                    suites,
                    pocket,
                    seed_bases,
                )
            )
        else:
            os.close(wfd)
            procs.append((pid, os.fdopen(rfd, "rb")))

    seed_outputs: set[str] = set()
    for pid, reader in procs:
        log_records, arch_seed_outputs = pickle.load(reader)
        for rec in log_records:
            germinate_logger.handle(pickle.loads(rec))
        seed_outputs |= arch_seed_outputs
        reader.close()
        os.waitpid(pid, 0)

    for output in Path(outdir).glob(f"*/{series}/{pocket}/*"):
        if output.name not in seed_outputs:
            output.unlink()


if __name__ == "__main__":
    sys.exit(main())
